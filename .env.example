# Settings for running bin/releash by hand against the local Unleash stack (task services).
# These tokens are fixed dev-only values from docker-compose.yaml. They are not secrets and only work on that stack.
# Load them with: set -a; . ./.env.example; set +a

UNLEASH_URL='http://localhost:4242'

# Client token for the production environment. Use the development token to see development's configuration.
UNLEASH_API_TOKEN='default:production.releash-dev-not-a-secret'
# UNLEASH_API_TOKEN='default:development.releash-dev-not-a-secret'

# Admin token, for the Admin API and unleash/seed.py. releash itself does not use it.
UNLEASH_ADMIN_TOKEN='*:*.releash-dev-admin-not-a-secret'
